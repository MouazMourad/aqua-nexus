# Aqua Nexus server / VPS
AQUA_DOMAIN=aquanexus.example.com

# PostgreSQL
POSTGRES_DB=aqua_nexus
POSTGRES_USER=aqua
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://aqua:change-me@localhost:5432/aqua_nexus
DATABASE_SSL=disable
# For managed PostgreSQL with TLS:
# DATABASE_SSL=require
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_INSECURE=1 is a temporary testing escape hatch only; production should verify the server certificate.
DATABASE_SSL_CA=
DATABASE_SSL_INSECURE=0
DATABASE_POOL_MAX=10

# Durable image storage on the server
AQUA_UPLOAD_DIR=/var/lib/aqua-nexus/uploads
AQUA_UPLOAD_MAX_MB=12

# Optional external AI provider (OpenAI-compatible chat/vision endpoint)
# Leave blank to keep using Aqua Nexus local intelligence only.
AQUA_AI_BASE_URL=
AQUA_AI_API_KEY=
AQUA_AI_MODEL=

# Web Push. VAPID_PUBLIC_KEY must match the public key used by the PWA client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Protect scheduled background jobs
CRON_SECRET=change-this-to-a-long-random-secret
